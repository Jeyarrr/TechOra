PORT=3000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/techora
PG_POOL_MAX=1

# Required only when deploying image uploads on Vercel with Supabase Storage.
# Never expose the secret key to the browser or commit a real value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_STORAGE_BUCKET=product-images

# Used only by `npm run seed:admin`. Keep the real values in your untracked .env file.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=use-a-unique-password-with-at-least-12-characters
ADMIN_FIRST_NAME=Techora
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=09000000000
